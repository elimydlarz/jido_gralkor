+        do: Application.put_env(:jido_gralkor, :lenses, previous_lenses),
+        else: Application.delete_env(:jido_gralkor, :lenses)
+
+      if previous_storage,
+        do: Application.put_env(:jido_gralkor, :lens_storage, previous_storage),
