# Copy to .env (gitignored) and fill in real values. Loaded by test/test_helper.exs.

# Required to publish jido_gralkor to the public Hex registry. Use a
# gralkor-organization repository key with package publish permission.
GRALKOR_HEX_TOKEN=

# Required to create the lightweight release tag through GitHub's API without
# bypassing trunk-sync. Use a fine-grained token for this repository with
# Contents write permission.
GH_TOKEN=

# Required for tests that hit a real LLM (the functional ontology-extraction test
# and either journey test). Either GOOGLE_API_KEY or GEMINI_API_KEY satisfies the
# Gemini provider configured by Gralkor.Config.
GOOGLE_API_KEY=

# Required for the interpretation-only epistemic-humility functional suite.
# It calls OpenAI gpt-4.1-mini through ReqLLM and does not start Graphiti/FalkorDB.
OPENAI_API_KEY=

# Required for the embedded FalkorDB integration path. Pick a writable directory;
# falkordblite will spawn a redis-server grandchild under it.
GRALKOR_DATA_DIR=/tmp/gralkor

# Optional model overrides (see Gralkor.Config). Format: provider:model
# GRALKOR_LLM_MODEL=google:gemini-2.5-flash
# GRALKOR_EMBEDDER_MODEL=google:gemini-embedding-001

# Required only for `mix test.journey` against a real remote FalkorDB
# (test/functional/remote_falkordb_journey_test.exs). Start one with:
#   docker run -p 6380:6379 falkordb/falkordb
# FALKORDB_TEST_HOST=localhost
# FALKORDB_TEST_PORT=6380
# FALKORDB_TEST_USERNAME=
# FALKORDB_TEST_PASSWORD=
# FALKORDB_TEST_SSL=false
