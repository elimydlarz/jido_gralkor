# Copy to .env (gitignored) and fill in real values. Loaded by test/test_helper.exs.

# Required to publish jido_gralkor and retire the legacy packages. Use a
# user API key with `api:write` permission for the personal Hex user `elimydlarz`, which owns
# `jido_gralkor`, `gralkor`, and `gralkor_ex`.
HEX_TOKEN=

# Required to create the lightweight release tag through GitHub's API without
# bypassing trunk-sync. Use a fine-grained token for this repository with
# Contents write permission.
GH_TOKEN=

# The only inference credential the test suites need. Both roles below select
# OpenAI, so this one key covers every suite that hits a real provider: the
# functional ontology-extraction suite and the LLM-backed memory-adventure
# Journey.
OPENAI_API_KEY=

# Pin both inference roles to OpenAI (see Gralkor.Config). Format: provider:model.
# The package defaults are Google; the test suites override them here so a single
# OPENAI_API_KEY is sufficient. A provider no role selects needs no
# credential, so GOOGLE_API_KEY is not required to run the suites.
GRALKOR_LLM_MODEL=openai:gpt-6-astra
GRALKOR_EMBEDDER_MODEL=openai:text-embedding-3-small

# gpt-6-astra rejects the `none` effort Graphiti's `auto` reasoning sends for
# GPT-5.1 and later; it accepts low and above.
GRALKOR_LLM_REASONING=low

# Optional inference settings. Unset means Graphiti's own default; see README.md.
# GRALKOR_RERANKER_MODEL=openai:gpt-4.1-mini
# GRALKOR_LLM_ROUTES={"extract_edges.extract_timestamps": {"model": "openai:gpt-6-luna"}}
# GRALKOR_LLM_TEMPERATURE=
# GRALKOR_LLM_MAX_TOKENS=
# GRALKOR_LLM_VERBOSITY=
# GRALKOR_LLM_THINKING_BUDGET=
# GRALKOR_EMBEDDER_DIMENSION=
# GRALKOR_EMBEDDER_BATCH_SIZE=

# Set only if you point a role back at Google. Either GOOGLE_API_KEY or
# GEMINI_API_KEY satisfies the Gemini provider.
# GOOGLE_API_KEY=

# Required for the embedded FalkorDB integration path. Pick a writable directory;
# falkordblite will spawn a redis-server grandchild under it.
GRALKOR_DATA_DIR=/tmp/gralkor
